diff --git a/pico/draw.c b/pico/draw.c
index 526f18e..0694854 100644
--- a/pico/draw.c
+++ b/pico/draw.c
@@ -1973,6 +1973,23 @@ void PicoDrawBgcDMA(u16 *base, u32 source, u32 mask, int dlen, int sl)
 }
 
 // also works for fast renderer
+// runtime saturation applied to the finished palette (0 = off). Baked into
+// HighPal when it is rebuilt, so per-pixel rendering cost is unchanged.
+int pico_saturation = 0;
+unsigned short pico_sat565(unsigned short c)
+{
+  int f = 256 + pico_saturation * 40; // 1 = ~1.16x, up per level
+  int r = ((c >> 11) & 0x1f) << 3, g = ((c >> 5) & 0x3f) << 2, b = (c & 0x1f) << 3;
+  int y = (r * 77 + g * 150 + b * 29) >> 8;
+  int nr = y + (((r - y) * f) >> 8);
+  int ng = y + (((g - y) * f) >> 8);
+  int nb = y + (((b - y) * f) >> 8);
+  if (nr < 0) nr = 0; else if (nr > 255) nr = 255;
+  if (ng < 0) ng = 0; else if (ng > 255) ng = 255;
+  if (nb < 0) nb = 0; else if (nb > 255) nb = 255;
+  return ((nr >> 3) << 11) | ((ng >> 2) << 5) | (nb >> 3);
+}
+
 void PicoDrawUpdateHighPal(void)
 {
   struct PicoEState *est = &Pico.est;
@@ -1995,6 +2012,12 @@ void PicoDrawUpdateHighPal(void)
     }
     est->HighPal[0xe0] = 0x0000; // black and white, reserved for OSD
     est->HighPal[0xf0] = 0xffff;
+
+    if (pico_saturation) {
+      int j;
+      for (j = 0; j < 0xe0; j++)
+        est->HighPal[j] = pico_sat565(est->HighPal[j]);
+    }
   }
 }
 
