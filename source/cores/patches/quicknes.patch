 		   for (unsigned i = 0; i < 256; i++)
 		   {
 			   const Nes_Emu::rgb_t& rgb = current_nes_colors[frame.palette[i]];
@@ -1367,6 +1398,9 @@ void retro_run(void)
 	         retro_palette[i] = ((rgb.red & 0xf8) << 8) | ((rgb.green & 0xfc) << 3) | ((rgb.blue & 0xf8) >> 3);
 #endif
