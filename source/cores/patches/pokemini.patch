diff --git a/Makefile.libretro b/Makefile.libretro
index 9660e99..cca6dad 100644
--- a/Makefile.libretro
+++ b/Makefile.libretro
@@ -484,6 +484,17 @@ else ifeq ($(platform), miyoo)
 	CFLAGS += -ffast-math -fomit-frame-pointer -march=armv5te -mtune=arm926ej-s
 	CFLAGS += -DDINGUX -DRS90
 
+else ifeq ($(platform), trimui)
+	TARGET := $(TARGET_NAME)_libretro.so
+	CC  = $(CROSS_COMPILE)gcc
+	CXX = $(CROSS_COMPILE)g++
+	AR  = $(CROSS_COMPILE)ar
+	SHARED := -shared -nostdlib -Wl,-version-script=libretro/link.T
+	fpic := -fPIC -DPIC
+	CFLAGS += $(PTHREAD_FLAGS)
+	CFLAGS += -ffast-math -fomit-frame-pointer -march=armv5te -mtune=arm926ej-s
+	CFLAGS += -DDINGUX -DRS90
+
 # GCW0
 else ifeq ($(platform), gcw0)
 	TARGET := $(TARGET_NAME)_libretro.so
@@ -727,3 +738,9 @@ endif
 
 endif
 
+
+# TRIMUI MODEL S: the generic release block appends -O2 after the platform
+# section and the last -O flag wins, so re-override at the end
+ifeq ($(platform), trimui)
+CFLAGS += -O3
+endif
